# Backend API Base URL (leave empty for local demo mock fallback)
VITE_API_BASE_URL=http://localhost:5000/api

# PostgreSQL Database Connection String (for backend server)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kdp_greensource

