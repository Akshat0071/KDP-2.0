    Dimension_Table_Site {
        int Site_ID PK
        varchar Site_Name
        varchar Facility_Type
        varchar Location
    }

    Dimension_Table_User_Info {
        int User_ID PK
        int Site_ID FK
        varchar Email UK
        varchar Password_Hash
        varchar Name
        varchar Role
        timestamptz Created_At
        timestamptz Last_Login
    }

    Dimension_Table_Green_Materials {
        int Green_Material_ID PK
        varchar Green_Material_Description
        decimal Price
    }

    Dimension_Table_Green_Material_Alternate {
        int Green_Material_ID PK,FK
        int Alternate_Green_ID PK,FK
    }

    Dimension_Table_Shipping_Cost {
        int Warehouse_ID PK,FK
        int Site_ID PK,FK
        decimal Cost
        int Lead_Time_Days
    }

    Fact_Table_Inventory {
        int Site_ID PK,FK
        int Green_Material_ID PK,FK
        decimal Quantity_Available
        decimal Minimum_Threshold
        varchar Unit_of_Measurement
        date Updated_Date
    }

    Fact_Table_Orders {
        int Order_Number PK
        int Site_ID FK
        varchar Order_Type
        int FG_Material_ID
        varchar FG_Material_Description
        varchar Brand
        varchar Brand_Type
        int Green_Material_ID FK
        decimal Order_Quantity
        varchar Unit_of_Measurement
        int Selected_Option_ID FK
        date Schedule_Start_Date
        varchar Status
        boolean Is_Closed
        jsonb Timeline_History
        timestamptz Created_At
        date Updated_Date
    }

    Fact_Table_Optimization_Table {
        int Option_ID PK
        int Order_Number PK,FK
        int Green_Material_ID FK
        int Source_Site_ID FK
        int Selected_Green_ID FK
        decimal Allocated_Quantity
        decimal Green_Unit_Price
        decimal Shipping_Cost
        decimal Total_Cost
        int Lead_Time_Days
        boolean Is_Feasible
        boolean Is_Selected
        boolean Procurement_Required
    }

    Fact_Table_Shipment_Details {
        int Shipment_ID PK
        int Order_Number FK
        int From_Site_ID FK
        int To_Site_ID FK
        int Green_Material_ID FK
        decimal Shipment_Quantity
        varchar Unit_of_Measurement
        date Shipped_Date
        date Estimated_Arrival_Date
        date Delivery_Date
        decimal Shipping_Cost
        varchar Shipment_Status
        boolean Is_Delayed
        date Updated_Date
    }

    Fact_Table_Notifications {
        int Notification_ID PK
        int Site_ID FK
        int User_ID FK
        varchar Severity
        varchar Type
        varchar Title
        text Message
        varchar Action_Label
        varchar Action_URL
        boolean Is_Read
        timestamptz Created_At
    }

    Fact_Table_Audit_Logs {
        int Log_ID PK
        int User_ID FK
        varchar Action_Type
        varchar Target_Entity
        int Target_ID
        jsonb Details
        timestamptz Created_At
    }
